<div class="accountProfile-edit-page">
  <div class="accountProfile-edit-form">
    <h2>アカウント情報の編集</h2>

    <ul class = "error-message">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "ユーザー名を入力", class: "input-field" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="field">
        <%= f.label :password, "新しいパスワード" %><span>(変更する場合のみ)</span><br />
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "新しいパスワードを入力" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "確認用パスワード" %><span>(変更する場合のみ)</span><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "確認用パスワードを入力", class: "input-field" %>
      </div>

      <div class="field">
        <%= f.label :current_password, "現在のパスワード", class: "current-password-label" %><br />
        <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "現在のパスワードを入力" %>
      </div>

      <div class="actions">
        <%= f.submit "更新する", class: "actions-button" %>
        <%= link_to "キャンセル", :back, class: "link-button" %>
      </div>
    <% end %>
  </div>
</div>
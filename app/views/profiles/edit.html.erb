<div class="accountProfile-edit-page">
  <div class="accountProfile-edit-form">
    <h2>プロフィール情報の編集</h2>

    <ul class = "error-message">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>

    <%= form_with model: @user, url: :profiles, method: :patch, local: true, html: { multipart: true } do |f| %>
      <div class="field">
        <%= f.label :icon, "プロフィール画像" %>
        <div class="icon-form">
        <% if @user.icon.attached? %>
          <%= image_tag @user.icon %>
        <% end %>
        <%= f.file_field :icon %>
        </div>
      </div>

      <div class="field">
        <%= f.label :name, "名前" %><br />
        <%= f.text_field :name, placeholder: "名前を入力" %>
      </div>

      <div class="field">
        <%= f.label :introduction, "自己紹介" %><br />
        <%= f.text_area :introduction, placeholder: "自己紹介を入力" %>
      </div>

      <div class="actions">
        <%= f.submit "更新する", class: "actions-button" %>
        <%= link_to "キャンセル", :back, class: "link-button" %>
      </div>
    <% end %>
  </div>
</div>


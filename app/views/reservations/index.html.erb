<div class="reservation-list">
  <h2>予約済み一覧</h2>

  <table>
    <thead>
      <tr>
        <th>施設画像</th>
        <th>施設名</th>
        <th>紹介文</th>
        <th>合計料金</th>
        <th>チェックイン日</th>
        <th>チェックアウト日</th>
        <th>予約確定日時</th>
        <th></th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @reservations.each do |r| %>
          <tr>
              <td>
                <% if r.room.facility_image.attached? %>
                  <%= image_tag r.room.facility_image, alt: "施設画像" %>
                <% else %>
                  <%= image_tag '/assets/default.png', alt: "施設画像" %>
                <% end %>
              </td>
              <td><%= link_to r.room.facility_name, r.room %></td>
              <td><%= r.room.facility_Introduction.truncate(100) %></td>
              <td>¥<%= r.total_price.to_s(:delimited) %>~</td>
              <td><%= r.checkin_date.strftime("%Y/%m/%d") %></td>
              <td><%= r.checkout_date.strftime("%Y/%m/%d") %></td>
              <td><%= r.created_at.strftime('%Y/%m/%d %H:%M') %></td>
              <td><%= link_to "再予約", edit_reservation_path(r) %></td>
              <td><%= link_to "予約を削除", reservation_path(r), method: :delete, data: { confirm: "予約を削除しますか？" } %></td>
          </tr>
      <% end %>
    </tbody>
  </table>
</div>
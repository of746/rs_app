<div class="search_form">
  <%= form_with url: search_rooms_path, method: :get, local: true do %>
    <div class="search_field_wrapper">
      <div class="search_field">
        <%= label :area ,"エリア検索" %>
        <%= select_tag :area, options_for_select(["", "東京", "大阪", "京都", "札幌"], params[:area]) %>

        <%= label :keyword ,"フリーワード検索" %>
        <%= text_field_tag :keyword, params[:keyword], placeholder: "施設名・施設詳細" %>
      </div>

      <div class="search_button">
        <%= submit_tag "検索" %>
      </div>
    </div>
  <% end %>
</div>
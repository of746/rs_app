<div class="facility-list">
  <h2>登録済み一覧</h2>

  <table>
    <thead>
      <tr>
        <th>画像</th>
        <th>施設名</th>
        <th>紹介文</th>
        <th>宿泊料金</th>
        <th>作成日</th>
        <th></th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @rooms.each do |room| %>
        <% if room.user_id == current_user.id %>
          <tr>
              <td>
                <% if room.facility_image.attached? %>
                  <%= image_tag room.facility_image, alt: "施設画像" %>
                <% else %>
                  <%= image_tag '/assets/default.png', alt: "施設画像" %>
                <% end %>
              </td>
              <td><%= link_to room.facility_name, room %></td>
              <td><%= room.facility_Introduction %></td>
              <td>¥<%= room.fee.to_s(:delimited) %>~</td>
              <td><%= room.created_at.to_s(:datetime_jp) %></td>
              <td><%= link_to "編集", [:edit, room] %></td>
              <td><%= link_to "削除", room, method: :delete, data: { confirm: "本当に削除しますか？" } %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

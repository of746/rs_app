<div class="search_result">
  <h3><%= @total_count %>件が見つかりました。</h3>

  <div class="grid-container">
    <% @rooms.each do |room| %>
      <div class="room-card">
        <div class="room_image">
          <% if room.facility_image.attached? %>
            <%= image_tag room.facility_image, alt: "施設画像" %>
          <% else %>
            <%= image_tag '/assets/default.png', alt: "施設画像" %>
          <% end %>
        </div>
        <h3 class="room_facility-name"><%= room.facility_name %></h3>
        <p class="room_address"><%= room.address %></p>
        <p class="room_facility-Introduction"><%= room.facility_Introduction.truncate(50) %></p>
        <p class="room_fee">¥<%= room.fee %>~/日</p>
        <div class="room_link"><%= link_to "詳細", room_path(room) %></div>
      </div>
    <% end %>
  </div>
</div>